@inherits LayoutComponentBase
@implements IDisposable

@inject IJSRuntime JSRuntime
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="toolbar-auth">
                @if (!AuthService.IsAuthenticated)
                {
                    <button class="btn-link auth-btn" @onclick="LoginAzure">Login Azure</button>
                    <button class="btn-link auth-btn" @onclick="LoginGoogle">Login Google</button>
                }
                else
                {
                    <span class="user-pill">@(AuthService.CurrentUser?.DisplayName ?? "User")</span>
                    <button class="btn-link auth-btn" @onclick="OpenScenarios">Scenarios</button>
                    <button class="btn-link auth-btn" @onclick="Logout">Log Out</button>
                }
            </div>
            <a class="about-link" href="#" @onclick="ShowAboutModal" @onclick:preventDefault>About</a>
        </div>
        @if (!string.IsNullOrWhiteSpace(loginError))
        {
            <div class="login-error-panel">
                <span>Login failed: @loginError</span>
                <button class="btn-link auth-btn" @onclick="DismissLoginError">Dismiss</button>
            </div>
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (ShowAbout)
{
    <!-- Modal Backdrop -->
    <div class="modal-backdrop" @onclick="HideAboutModal"></div>

    <!-- Modal Dialog -->
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3>About AI-ATC</h3>
                <button class="close-button" @onclick="HideAboutModal">&times;</button>
            </div>
            <div class="modal-body">
                <img src="splash.png" alt="AI-ATC Splash Screen" class="splash-image" />
            </div>
        </div>
    </div>
}

@code {
    private bool ShowAbout { get; set; } = false;
    private string? loginError;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += HandleAuthStateChanged;
        await AuthService.InitializeAsync();
    }

    private void ShowAboutModal()
    {
        ShowAbout = true;
        StateHasChanged();
    }

    private void HideAboutModal()
    {
        ShowAbout = false;
        StateHasChanged();
    }

    private async Task LoginAzure() => await RunLogin(async () => await AuthService.LoginWithAzureAsync());
    private async Task LoginGoogle() => await RunLogin(async () => await AuthService.LoginWithGoogleAsync());
    private async Task Logout() => await AuthService.LogoutAsync();
    private void OpenScenarios() => NavigationManager.NavigateTo("/?openScenarios=1");

    private async Task RunLogin(Func<Task> loginAction)
    {
        try
        {
            loginError = null;
            await loginAction();
        }
        catch (Exception ex)
        {
            loginError = ex.Message;
            StateHasChanged();
        }
    }

    private void DismissLoginError()
    {
        loginError = null;
    }

    private void HandleAuthStateChanged()
    {
        if (AuthService.IsAuthenticated)
        {
            loginError = null;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= HandleAuthStateChanged;
    }
}
