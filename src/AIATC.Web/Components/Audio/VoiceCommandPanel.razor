@using AIATC.Web.Services
@using AIATC.Domain.Models.Commands
@using System.Linq
@inject SpeechRecognitionService SpeechRecognition
@inject TextToSpeechService TextToSpeech
@implements IAsyncDisposable

<div class="voice-command-panel">
    <div class="voice-status">
        @if (!_isInitialized)
        {
            <div class="status-warning">
                <span>⚠️ Voice commands not available in this browser</span>
            </div>
        }
        else if (!_hasPermission)
        {
            <button class="permission-button"
                    @onclick="RequestPermission"
                    title="Request microphone permission">
                <span>🎤</span>
                <span>Allow Microphone</span>
            </button>
        }
        else
        {
            <button class="mic-button @(_isListening ? "listening" : "")"
                    @onclick="ToggleMicrophone"
                    title="@(_isListening ? "Stop listening" : "Start voice commands")">
                @if (_isListening)
                {
                    <span class="mic-icon">🔴</span>
                    <span>Listening...</span>
                }
                else
                {
                    <span class="mic-icon">🎤</span>
                    <span>Voice Commands</span>
                }
            </button>

            @if (EnableTextToSpeech)
            {
                <button class="tts-button @(_ttsEnabled ? "active" : "")"
                        @onclick="ToggleTts"
                        title="@(_ttsEnabled ? "Disable" : "Enable") pilot readbacks">
                    <span>🔊</span>
                    <span>@(_ttsEnabled ? "TTS On" : "TTS Off")</span>
                </button>
            }
        }
    </div>

    <!-- Text Input Fallback for Testing -->
    @if (!_hasPermission || !_isInitialized)
    {
        <div class="text-input-fallback">
            <div class="fallback-label">
                <span>🎯 Text Input (for testing):</span>
            </div>
            <div class="fallback-input">
                <input type="text" 
                       @bind="_testCommandText"
                       @onkeydown="OnTestCommandKeyDown"
                       placeholder="Type command (e.g., 'United 123, turn right heading 110')"
                       class="test-command-input" />
                <button @onclick="SubmitTestCommand" 
                        class="test-submit-button"
                        disabled="@string.IsNullOrWhiteSpace(_testCommandText)">
                    Send
                </button>
            </div>
        </div>
    }

    @if (_isListening && !string.IsNullOrEmpty(_lastTranscript))
    {
        <div class="transcript-display">
            <span class="transcript-label">Heard:</span>
            <span class="transcript-text">@_lastTranscript</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(_lastError))
    {
        <div class="error-display">
            <span>⚠️ @_lastError</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<string> OnCommandRecognized { get; set; }

    [Parameter]
    public EventCallback<string> OnReadbackSpoken { get; set; }

    [Parameter]
    public bool EnableTextToSpeech { get; set; } = true;

    [Parameter]
    public AtcCommandParser? Parser { get; set; }

    private bool _isInitialized;
    private bool _isListening;
    private bool _ttsEnabled = true;
    private bool _hasPermission;
    private string? _lastTranscript;
    private string? _lastError;
    private string _testCommandText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Initialize speech recognition
        _isInitialized = await SpeechRecognition.InitializeAsync();

        if (_isInitialized)
        {
            // Check current permission status
            _hasPermission = await SpeechRecognition.HasPermissionAsync();

            SpeechRecognition.SpeechRecognized += OnSpeechRecognized;
            SpeechRecognition.SpeechError += OnSpeechError;
            SpeechRecognition.ListeningStarted += OnListeningStarted;
            SpeechRecognition.ListeningStopped += OnListeningStopped;
            SpeechRecognition.PermissionDenied += OnPermissionDenied;
        }

        // Initialize TTS
        if (EnableTextToSpeech)
        {
            await TextToSpeech.InitializeAsync();
        }
    }

    private async Task ToggleMicrophone()
    {
        await SpeechRecognition.ToggleListeningAsync();
    }

    private async Task RequestPermission()
    {
        _lastError = null;
        var granted = await SpeechRecognition.RequestPermissionAsync();

        if (granted)
        {
            _hasPermission = true;
            _lastError = "Microphone permission granted!";
        }
        else
        {
            _hasPermission = false;
            _lastError = "Microphone permission denied. Please allow microphone access in your browser settings.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ToggleTts()
    {
        _ttsEnabled = !_ttsEnabled;
    }

    // Text input fallback methods
    private async Task OnTestCommandKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitTestCommand();
        }
    }

    private async Task SubmitTestCommand()
    {
        if (string.IsNullOrWhiteSpace(_testCommandText))
            return;

        Console.WriteLine($"[DEBUG] Test command submitted: '{_testCommandText}'");

        // Simulate the speech recognition flow
        await SimulateVoiceCommand(_testCommandText);

        _testCommandText = string.Empty;
    }

    private async Task SimulateVoiceCommand(string transcript)
    {
        // This simulates what OnSpeechRecognized does
        _lastTranscript = transcript;
        _lastError = null;

        Console.WriteLine($"[DEBUG] Simulated speech recognized: '{transcript}'");

        // Filter out readback-like responses to prevent feedback loops
        var lowerTranscript = transcript.ToLower();
        if (IsLikelyReadback(lowerTranscript))
        {
            Console.WriteLine($"[DEBUG] Filtered readback: '{transcript}'");
            return;
        }

        Console.WriteLine($"[DEBUG] Checking if can parse: '{transcript}'");

        // Validate if it's a valid command
        if (Parser != null && !Parser.CanParse(transcript))
        {
            Console.WriteLine($"[DEBUG] Cannot parse command: '{transcript}'");
            _lastError = "Invalid command";
            await InvokeAsync(StateHasChanged);
            return;
        }

        Console.WriteLine($"[DEBUG] Sending command to parent: '{transcript}'");

        // Notify parent component
        await OnCommandRecognized.InvokeAsync(transcript);

        await InvokeAsync(StateHasChanged);
    }

    private async void OnSpeechRecognized(object? sender, string transcript)
    {
        _lastTranscript = transcript;
        _lastError = null;

        Console.WriteLine($"[DEBUG] Speech recognized: '{transcript}'");

        // Filter out readback-like responses to prevent feedback loops
        var lowerTranscript = transcript.ToLower();
        if (IsLikelyReadback(lowerTranscript))
        {
            Console.WriteLine($"[DEBUG] Filtered readback: '{transcript}'");
            return;
        }

        Console.WriteLine($"[DEBUG] Checking if can parse: '{transcript}'");

        // Validate if it's a valid command
        if (Parser != null && !Parser.CanParse(transcript))
        {
            Console.WriteLine($"[DEBUG] Cannot parse command: '{transcript}'");
            _lastError = "Invalid command";
            await InvokeAsync(StateHasChanged);
            return;
        }

        Console.WriteLine($"[DEBUG] Sending command to parent: '{transcript}'");

        // Notify parent component
        await OnCommandRecognized.InvokeAsync(transcript);

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Detects if the transcript is likely a pilot readback to filter out feedback
    /// </summary>
    private bool IsLikelyReadback(string transcript)
    {
        // Only filter responses that sound like pilot acknowledgments, 
        // not controller instructions that might contain similar words
        var readbackPhrases = new[]
        {
            "roger", "wilco", "affirm", "affirmative", "negative", 
            "copy that", "understood", "will comply"
        };
        
        // Check if the transcript is ONLY a readback phrase or starts with callsign + readback
        foreach (var phrase in readbackPhrases)
        {
            // Match exact readback or "CALLSIGN, readback"
            if (transcript.Equals(phrase, StringComparison.OrdinalIgnoreCase) ||
                transcript.EndsWith($", {phrase}", StringComparison.OrdinalIgnoreCase) ||
                transcript.EndsWith($" {phrase}", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        
        return false;
    }

    private async void OnSpeechError(object? sender, string error)
    {
        _lastError = $"Error: {error}";
        await InvokeAsync(StateHasChanged);
    }

    private async void OnListeningStarted(object? sender, EventArgs e)
    {
        _isListening = true;
        _lastError = null;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnListeningStopped(object? sender, EventArgs e)
    {
        _isListening = false;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnPermissionDenied(object? sender, EventArgs e)
    {
        _isListening = false;
        _hasPermission = false;
        _lastError = "Microphone permission was denied or revoked.";
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Speaks pilot readback (called from parent)
    /// </summary>
    public async Task SpeakReadbackAsync(string callsign, string readback)
    {
        if (!_ttsEnabled || !EnableTextToSpeech)
            return;

        // Temporarily pause listening to avoid feedback loop
        bool wasListening = _isListening;
        if (wasListening)
        {
            await SpeechRecognition.StopListeningAsync();
        }

        try
        {
            await TextToSpeech.SpeakPilotReadbackAsync(callsign, readback);
            // Notify parent with proper aviation format: instruction, callsign
            await OnReadbackSpoken.InvokeAsync($"{readback}, {callsign}");
            
            // Wait a bit for TTS to finish and audio to clear
            await Task.Delay(1000);
        }
        finally
        {
            // Resume listening if it was active before
            if (wasListening)
            {
                await SpeechRecognition.StartListeningAsync();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isInitialized)
        {
            SpeechRecognition.SpeechRecognized -= OnSpeechRecognized;
            SpeechRecognition.SpeechError -= OnSpeechError;
            SpeechRecognition.ListeningStarted -= OnListeningStarted;
            SpeechRecognition.ListeningStopped -= OnListeningStopped;
            SpeechRecognition.PermissionDenied -= OnPermissionDenied;

            await SpeechRecognition.DisposeAsync();
        }
    }
}

<style>
    .text-input-fallback {
        margin-top: 10px;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #f9f9f9;
    }

    .fallback-label {
        font-weight: bold;
        margin-bottom: 5px;
        color: #666;
    }

    .fallback-input {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .test-command-input {
        flex: 1;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 3px;
        font-family: monospace;
    }

    .test-submit-button {
        padding: 8px 16px;
        background-color: #007acc;
        color: white;
        border: none;
        border-radius: 3px;
        cursor: pointer;
    }

    .test-submit-button:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }

    .test-submit-button:hover:not(:disabled) {
        background-color: #005a9e;
    }
</style>
