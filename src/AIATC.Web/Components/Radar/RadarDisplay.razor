@using AIATC.Domain.Models
@using AIATC.Domain.Models.Navigation
@using AIATC.Domain.Models.Aviation
@using AIATC.Web.Services
@using Serilog
@inject IJSRuntime JS
@inject INavigationService NavigationService

<div class="radar-container" @ref="radarContainer">
    <canvas @ref="radarCanvas"
            width="@CanvasWidth"
            height="@CanvasHeight"
            @onmousedown="OnMouseDown"
            @onmousemove="OnMouseMove"
            @onmouseup="OnMouseUp"
            @onmouseleave="OnMouseLeave"
            @oncontextmenu:preventDefault="true"
            @onwheel="OnWheel">
    </canvas>

    @if (SelectedAircraft != null)
    {
        <div class="aircraft-info-panel">
            <h3>@SelectedAircraft.Callsign</h3>
            <div class="info-row">
                <span>Altitude:</span>
                <span>@((int)SelectedAircraft.AltitudeFt) ft</span>
            </div>
            <div class="info-row">
                <span>Speed:</span>
                <span>@((int)SelectedAircraft.SpeedKnots) kts</span>
            </div>
            <div class="info-row">
                <span>Heading:</span>
                <span>@((int)SelectedAircraft.HeadingDegrees)°</span>
            </div>
            @if (SelectedAircraft.TargetHeadingDegrees.HasValue)
            {
                <div class="info-row">
                    <span>Target Hdg:</span>
                    <span>@((int)SelectedAircraft.TargetHeadingDegrees.Value)°</span>
                </div>
            }
            @if (SelectedAircraft.TargetAltitudeFt.HasValue)
            {
                <div class="info-row">
                    <span>Target Alt:</span>
                    <span>@((int)SelectedAircraft.TargetAltitudeFt.Value) ft</span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public List<AircraftModel> Aircraft { get; set; } = new();

    [Parameter]
    public List<Fix> Fixes { get; set; } = new();

    [Parameter]
    public AirportModel? Airport { get; set; }

    [Parameter]
    public List<Runway> Runways { get; set; } = new();

    [Parameter]
    public double CenterLatitude { get; set; } = 33.4255; // Default to Atlanta area

    [Parameter]
    public double CenterLongitude { get; set; } = -84.4693;

    [Parameter]
    public float RangeNm { get; set; } = 50.0f;

    [Parameter]
    public EventCallback<AircraftModel> OnAircraftSelected { get; set; }

    [Parameter]
    public int CanvasWidth { get; set; } = 1024;

    [Parameter]
    public int CanvasHeight { get; set; } = 768;

    [Parameter]
    public float MinZoomLevel { get; set; } = 0.5f;

    [Parameter]
    public float MaxZoomLevel { get; set; } = 8.0f;

    private ElementReference radarCanvas;
    private ElementReference radarContainer;
    private AircraftModel? SelectedAircraft { get; set; }

    // Pan and zoom state
    private Vector2 panOffset = new Vector2(0, 0);
    private float zoomLevel = 1.0f;
    private bool isPanning = false;
    private bool isLeftMouseDown = false;
    private bool hasDraggedSinceMouseDown = false;
    private Vector2 lastMousePos = new Vector2(0, 0);
    private Vector2 mouseDownPos = new Vector2(0, 0);
    private const float DragThresholdPx = 4.0f;
    private bool backgroundDirty = true;
    private DateTime lastPanRedrawUtc = DateTime.MinValue;
    private readonly TimeSpan panRedrawInterval = TimeSpan.FromMilliseconds(33);
    private List<Fix>? previousFixesRef;
    private List<Runway>? previousRunwaysRef;
    private AirportModel? previousAirportRef;
    private float previousRangeNm;
    private int previousCanvasWidth;
    private int previousCanvasHeight;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("radarDisplay.initialize", radarCanvas);
            backgroundDirty = true;
            await DrawRadar();
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previousFixesRef, Fixes) ||
            !ReferenceEquals(previousRunwaysRef, Runways) ||
            !ReferenceEquals(previousAirportRef, Airport) ||
            previousRangeNm != RangeNm ||
            previousCanvasWidth != CanvasWidth ||
            previousCanvasHeight != CanvasHeight)
        {
            backgroundDirty = true;
            previousFixesRef = Fixes;
            previousRunwaysRef = Runways;
            previousAirportRef = Airport;
            previousRangeNm = RangeNm;
            previousCanvasWidth = CanvasWidth;
            previousCanvasHeight = CanvasHeight;
        }
    }

    private async Task DrawRadar()
    {
        var centerX = CanvasWidth / 2.0f;
        var centerY = CanvasHeight / 2.0f;

        if (backgroundDirty)
        {
            await DrawStaticBackground(centerX, centerY);
            // Avoid re-caching every frame while panning; cache once after pan ends.
            if (!isPanning)
            {
                await JS.InvokeVoidAsync("radarDisplay.cacheBackground", radarCanvas);
            }
            backgroundDirty = false;
        }
        else
        {
            var restored = await JS.InvokeAsync<bool>("radarDisplay.drawCachedBackground", radarCanvas);
            if (!restored)
            {
                await DrawStaticBackground(centerX, centerY);
                await JS.InvokeVoidAsync("radarDisplay.cacheBackground", radarCanvas);
                backgroundDirty = false;
            }
        }

        await DrawDynamicForeground(centerX, centerY);
    }

    private async Task DrawDynamicForeground(float centerX, float centerY)
    {
        var items = Aircraft.Select(ac =>
        {
            var (screenX, screenY) = NmToScreen(ac.PositionNm, centerX, centerY);
            var isSelected = ReferenceEquals(SelectedAircraft, ac);
            return new
            {
                x = screenX,
                y = screenY,
                headingRad = ac.HeadingRadians,
                targetHeadingRad = ac.TargetHeadingDegrees.HasValue
                    ? ac.TargetHeadingDegrees.Value * SimulationConstants.DegreesToRadians
                    : (double?)null,
                color = isSelected ? "#00ff00" : "#00cc00",
                isSelected,
                callsign = ac.Callsign,
                altSpd = $"{(int)(ac.AltitudeFt / 100):D3} {(int)ac.SpeedKnots:D3}"
            };
        }).ToList();

        await JS.InvokeVoidAsync("radarDisplay.drawAircraftBatch", radarCanvas, items);
    }

    private async Task DrawStaticBackground(float centerX, float centerY)
    {
        // Clear canvas
        await JS.InvokeVoidAsync("radarDisplay.clearCanvas", radarCanvas);

        // Draw range rings
        await DrawRangeRings(centerX, centerY);

        // Draw fixes
        foreach (var fix in Fixes)
        {
            await DrawFix(fix, centerX, centerY);
        }

        // Draw airport + runways
        if (Airport != null)
        {
            await DrawAirport(Airport, centerX, centerY);
        }
    }

    private async Task DrawRangeRings(float centerX, float centerY)
    {
        var ringCount = 5;
        var pixelsPerNm = Math.Min(CanvasWidth, CanvasHeight) / (2.0f * RangeNm) * zoomLevel;

        for (int i = 1; i <= ringCount; i++)
        {
            var radiusNm = RangeNm * i / ringCount;
            var radiusPx = radiusNm * pixelsPerNm;

            await JS.InvokeVoidAsync("radarDisplay.drawCircle",
                radarCanvas,
                centerX + panOffset.X,
                centerY + panOffset.Y,
                radiusPx,
                "#2a4a2a",
                1);

            // Draw range label
            await JS.InvokeVoidAsync("radarDisplay.drawText",
                radarCanvas,
                $"{(int)radiusNm} NM",
                centerX + panOffset.X,
                centerY + panOffset.Y - radiusPx - 5,
                "#4a7a4a",
                "12px monospace");
        }
    }

    private async Task DrawFix(Fix fix, float centerX, float centerY)
    {
        var (screenX, screenY) = NmToScreen(fix.PositionNm, centerX, centerY);

        // Draw fix symbol (triangle)
        await JS.InvokeVoidAsync("radarDisplay.drawTriangle",
            radarCanvas,
            screenX,
            screenY,
            6,
            "#8888ff");

        // Draw fix label
        await JS.InvokeVoidAsync("radarDisplay.drawText",
            radarCanvas,
            fix.Identifier,
            screenX + 8,
            screenY - 8,
            "#aaaaff",
            "11px monospace");
    }

    private async Task DrawAirport(AirportModel airport, float centerX, float centerY)
    {
        var (screenX, screenY) = NmToScreen(airport.PositionNm, centerX, centerY);

        // Draw airport symbol (square)
        await JS.InvokeVoidAsync("radarDisplay.drawRect",
            radarCanvas,
            screenX - 5,
            screenY - 5,
            10,
            10,
            "#ffaa00");

        // Draw airport label
        await JS.InvokeVoidAsync("radarDisplay.drawText",
            radarCanvas,
            airport.IcaoCode,
            screenX + 8,
            screenY + 4,
            "#ffcc00",
            "bold 12px monospace");

        // Draw runways
        await DrawRunways(centerX, centerY);
    }

    private static Task DrawHistoryTrail(AircraftModel aircraft, float centerX, float centerY)
    {
        // TODO: Implement history trail when position history is added to aircraft model
        return Task.CompletedTask;
    }

    private (float x, float y) NmToScreen(Vector2 positionNm, float centerX, float centerY)
    {
        var pixelsPerNm = Math.Min(CanvasWidth, CanvasHeight) / (2.0f * RangeNm) * zoomLevel;

        var screenX = centerX + (positionNm.X * pixelsPerNm) + panOffset.X;
        var screenY = centerY - (positionNm.Y * pixelsPerNm) + panOffset.Y; // Y is inverted

        return (screenX, screenY);
    }

    private Vector2 ScreenToNm(float screenX, float screenY, float centerX, float centerY)
    {
        var pixelsPerNm = Math.Min(CanvasWidth, CanvasHeight) / (2.0f * RangeNm) * zoomLevel;

        var nmX = (screenX - centerX - panOffset.X) / pixelsPerNm;
        var nmY = -(screenY - centerY - panOffset.Y) / pixelsPerNm; // Y is inverted

        return new Vector2(nmX, nmY);
    }

    private Task OnMouseDown(MouseEventArgs e)
    {
        var clickPos = new Vector2((float)e.OffsetX, (float)e.OffsetY);
        mouseDownPos = clickPos;
        lastMousePos = clickPos;

        if (e.Button == 0) // Left click
        {
            Log.Information($"[{DateTime.Now:HH:mm:ss.fff}] MouseDown left at {clickPos}");
            isLeftMouseDown = true;
            hasDraggedSinceMouseDown = false;
        }
        else if (e.Button == 2) // Right click - start panning
        {
            Log.Information($"[{DateTime.Now:HH:mm:ss.fff}] MouseDown right at {clickPos}");
            isPanning = true;
            hasDraggedSinceMouseDown = true;
        }
        return Task.CompletedTask;
    }
    private async Task DrawRunways(float centerX, float centerY)
    {
        if (!Runways.Any()) return;

        foreach (var runway in Runways)
        {
            await DrawRunway(runway, centerX, centerY);
        }
    }

    private async Task DrawRunway(Runway runway, float centerX, float centerY)
    {
        // Get runway endpoints from the model
        var (startPos, endPos) = NavigationService.CalculateRunwayEndpoints(runway);
        
        // Convert to screen coordinates using existing NmToScreen method
        var (startX, startY) = NmToScreen(startPos, centerX, centerY);
        var (endX, endY) = NmToScreen(endPos, centerX, centerY);

        // Draw runway centerline
        await JS.InvokeVoidAsync("radarDisplay.drawLine",
            radarCanvas,
            startX, startY, endX, endY,
            "#ffffff", 3);

        // Draw runway outline (slightly wider)
        var runwayWidthNm = runway.WidthFt * 0.000164579f; // Convert feet to nautical miles
        var pixelsPerNm = Math.Min(CanvasWidth, CanvasHeight) / (2.0f * RangeNm) * zoomLevel;
        var runwayWidthPx = runwayWidthNm * pixelsPerNm;

        // Calculate perpendicular vector for runway width
        var runwayVectorX = endX - startX;
        var runwayVectorY = endY - startY;
        var runwayLength = (float)Math.Sqrt(runwayVectorX * runwayVectorX + runwayVectorY * runwayVectorY);
        
        if (runwayLength > 0)
        {
            var normalizedX = runwayVectorX / runwayLength;
            var normalizedY = runwayVectorY / runwayLength;
            var perpX = -normalizedY * (runwayWidthPx / 2);
            var perpY = normalizedX * (runwayWidthPx / 2);

            // Draw runway edges
            await JS.InvokeVoidAsync("radarDisplay.drawLine",
                radarCanvas,
                startX + perpX, startY + perpY,
                endX + perpX, endY + perpY,
                "#bbbbbb", 1);

            await JS.InvokeVoidAsync("radarDisplay.drawLine",
                radarCanvas,
                startX - perpX, startY - perpY,
                endX - perpX, endY - perpY,
                "#bbbbbb", 1);
        }

        // Draw runway identifier
        var midX = (startX + endX) / 2;
        var midY = (startY + endY) / 2;
        
        await JS.InvokeVoidAsync("radarDisplay.drawText",
            radarCanvas,
            runway.Identifier,
            midX + 5, midY - 5,
            "#ffffff", "10px monospace");
    }
    private async Task OnMouseMove(MouseEventArgs e)
    {
        var currentPos = new Vector2((float)e.OffsetX, (float)e.OffsetY);

        if (isLeftMouseDown && !isPanning)
        {
            var deltaFromDown = currentPos - mouseDownPos;
            if (deltaFromDown.Magnitude >= DragThresholdPx)
            {
                isPanning = true;
                hasDraggedSinceMouseDown = true;
            }
        }

        if (isPanning)
        {
            var delta = currentPos - lastMousePos;

            panOffset += delta;
            lastMousePos = currentPos;
            backgroundDirty = true;

            var now = DateTime.UtcNow;
            if (now - lastPanRedrawUtc >= panRedrawInterval)
            {
                lastPanRedrawUtc = now;
                await DrawRadar();
            }
        }
    }

    private async Task OnMouseUp(MouseEventArgs e)
    {
        if (e.Button == 0 && isLeftMouseDown)
        {
            var centerX = CanvasWidth / 2.0f;
            var centerY = CanvasHeight / 2.0f;
            if (!hasDraggedSinceMouseDown)
            {
                _ = SelectAircraftAtScreenPoint(mouseDownPos, centerX, centerY);
            }

            isLeftMouseDown = false;
            isPanning = false;
            hasDraggedSinceMouseDown = false;
            Log.Information($"[{DateTime.Now:HH:mm:ss.fff}] MouseUp left at {new Vector2((float)e.OffsetX, (float)e.OffsetY)}");

            return;
        }

        if (e.Button == 2) // Right click released
        {
            isPanning = false;
            backgroundDirty = true;
            Log.Information($"[{DateTime.Now:HH:mm:ss.fff}] MouseUp right at {new Vector2((float)e.OffsetX, (float)e.OffsetY)}");
            await DrawRadar();
        }
    }

    private void OnMouseLeave()
    {
        isPanning = false;
        isLeftMouseDown = false;
        hasDraggedSinceMouseDown = false;
    }

    private async Task SelectAircraftAtScreenPoint(Vector2 clickPos, float centerX, float centerY)
    {
        AircraftModel? clickedAircraft = null;
        float minDistance = 20;

        foreach (var aircraft in Aircraft)
        {
            var (screenX, screenY) = NmToScreen(aircraft.PositionNm, centerX, centerY);
            var distance = (float)Math.Sqrt(
                Math.Pow(clickPos.X - screenX, 2) +
                Math.Pow(clickPos.Y - screenY, 2));

            if (distance < minDistance)
            {
                minDistance = distance;
                clickedAircraft = aircraft;
            }
        }

        SelectedAircraft = clickedAircraft;
        if (clickedAircraft != null)
        {
            await OnAircraftSelected.InvokeAsync(clickedAircraft);
        }

        await DrawRadar();
    }

    private async Task OnWheel(WheelEventArgs e)
    {
        var zoomFactor = e.DeltaY > 0 ? 0.9f : 1.1f;
        zoomLevel = Math.Clamp(zoomLevel * zoomFactor, MinZoomLevel, MaxZoomLevel);
        backgroundDirty = true;
        Log.Information($"[{DateTime.Now:HH:mm:ss.fff}] MouseWheel {zoomFactor}");

        await DrawRadar();
    }

    public async Task UpdateDisplay()
    {
        await DrawRadar();
    }
}
