{
  "platform": {
    "apiRuntime": "dotnet:10.0"
  },
  "routes": [
    {
      "route": "/*.{png,jpg,jpeg,gif,svg,ico,woff,woff2,ttf,eot,css,js,json,map,wasm,dll,pdb,gz,br}",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/lib/*",
      "headers": {
        "cache-control": "public, max-age=31536000"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "cache-control": "public, max-age=31536000"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "cache-control": "public, max-age=31536000"
      }
    },
    {
      "route": "/_framework/*",
      "headers": {
        "cache-control": "public, max-age=31536000"
      }
    },
    {
      "route": "/data/*",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "route": "/sample-data/*",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".wasm": "application/wasm",
    ".dll": "application/octet-stream",
    ".pdb": "application/octet-stream",
    ".js": "application/javascript",
    ".css": "text/css"
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; connect-src 'self' https:; img-src 'self' data: https:; media-src 'self' data: https:; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:;"
  }
}