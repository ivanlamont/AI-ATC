@page "/"
@using AIATC.Domain.Models
@using AIATC.Domain.Models.Commands
@using AIATC.Domain.Models.Navigation
@using AIATC.Domain.Models.Scoring
@using AIATC.Domain.Models.Aviation
@using AIATC.Web.Components.Radar
@using AIATC.Web.Components.Controls
@using AIATC.Web.Components.Audio
@using AIATC.Web.Services
@using AIATC.ScenarioService.Protos
@using System.Linq
@using System.Text.RegularExpressions
@using AIATC.Domain.Services
@inject IJSRuntime JS
@inject TextToSpeechService TextToSpeech
@inject IAzureSpeechService SpeechService
@inject INavigationService NavigationService
@inject NavigationManager NavigationManager
@inject IScenarioServiceClient ScenarioServiceClient
@inject IAuthService AuthService
@inject IConfiguration Configuration

<PageTitle>AI ATC Simulation</PageTitle>

<div class="simulation-container">
    <div class="top-bar">
        <div class="airport-info">
            <h2>@(airport?.IcaoCode ?? "KSFO") Approach</h2>
            <span class="scenario-info">@scenarioName</span>
        </div>

        <div class="score-display">
            <div class="score-item">
                <span class="label">Score:</span>
                <span class="value">@sessionScore.TotalScore</span>
            </div>
            <div class="score-item">
                <span class="label">Aircraft:</span>
                <span class="value">@aircraft.Count</span>
            </div>
            <div class="score-item">
                <span class="label">Landings:</span>
                <span class="value">@sessionScore.Statistics.SuccessfulLandings</span>
            </div>
            <div class="score-item">
                <span class="label">Safety:</span>
                <span class="value">@sessionScore.Statistics.GetSafetyRating().ToString("F0")%</span>
            </div>
        </div>

        <div class="controls">
            <button class="control-btn @(isPaused ? "active" : "")" @onclick="TogglePause">
                @(isPaused ? "▶ Resume" : "⏸ Pause")
            </button>
            <select class="speed-select" @bind="timeMultiplier">
                <option value="1">1× Speed</option>
                <option value="2">2× Speed</option>
                <option value="4">4× Speed</option>
                <option value="8">8× Speed</option>
            </select>
            <button class="control-btn live-traffic-btn" @onclick="ReloadLiveTraffic" title="Reload with live air traffic and weather">
                🌐 Live Traffic
            </button>
            @if (AuthService.IsAuthenticated)
            {
                <button class="control-btn" @onclick="OpenScenariosModalAsync" title="Open scenarios">
                    📚 Scenarios
                </button>
                <button class="control-btn" @onclick="SaveScenarioAsync" title="Save current scenario state">
                    💾 Save
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(saveStatus))
    {
        <div class="scenario-info" style="padding: 0.4rem 1rem;">
            @saveStatus
        </div>
    }

    @if (showScenariosModal)
    {
        <div class="scenario-modal-backdrop" @onclick="CloseScenariosModal"></div>
        <div class="scenario-modal" role="dialog" aria-modal="true" aria-label="Scenarios">
            <div class="scenario-modal-header">
                <h3>Scenarios</h3>
                <button class="control-btn" @onclick="CloseScenariosModal">Close</button>
            </div>
            <div class="scenario-modal-body">
                <div class="scenario-list-pane">
                    <div class="scenario-modal-actions">
                        <button class="control-btn" @onclick="SaveScenarioAsync">Save Current</button>
                        <button class="control-btn" @onclick="LoadSelectedScenarioAsync" disabled="@(selectedScenario is null)">Load Selected</button>
                    </div>
                    @if (isLoadingScenarioCatalog)
                    {
                        <div class="scenario-info">Loading scenarios...</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(scenariosModalError))
                    {
                        <div class="scenario-info">@scenariosModalError</div>
                    }
                    else if (availableScenarios.Count == 0)
                    {
                        <div class="scenario-info">No scenarios available.</div>
                    }
                    else
                    {
                        @foreach (var item in availableScenarios)
                        {
                            var isSelected = selectedScenario?.Id == item.Id;
                            <button class="scenario-list-item @(isSelected ? "selected" : "")" @onclick="() => SelectScenario(item)">
                                <span class="name">@item.Name</span>
                                <span class="meta">@item.AirportCode · @item.Difficulty</span>
                            </button>
                        }
                    }
                </div>
                <div class="scenario-details-pane">
                    @if (selectedScenario == null)
                    {
                        <div class="scenario-info">Select a scenario to view details.</div>
                    }
                    else
                    {
                        <h4>@selectedScenario.Name</h4>
                        <div class="detail-row"><span>Location:</span><span>@selectedScenario.AirportCode</span></div>
                        <div class="detail-row"><span>Description:</span><span>@(string.IsNullOrWhiteSpace(selectedScenario.Description) ? "No description provided." : selectedScenario.Description)</span></div>
                        <div class="detail-row"><span>Number of airplanes:</span><span>@aircraft.Count</span></div>
                        <div class="detail-row"><span>Current score:</span><span>@sessionScore.TotalScore</span></div>
                        <div class="detail-row"><span>Weather summary:</span><span>@GetWeatherSummary()</span></div>
                        <div class="scenario-modal-actions">
                            <button class="control-btn" @onclick="CloseScenariosModal">OK</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="main-content">
        <div class="radar-section">
            <RadarDisplay Aircraft="@aircraft"
                          Fixes="@fixes"
                          Airport="@airport"
                          Runways="@runways"
                          RangeNm="50"
                          MinZoomLevel="@minRadarZoomLevel"
                          MaxZoomLevel="@maxRadarZoomLevel"
                          CanvasWidth="1024"
                          CanvasHeight="768"
                          OnAircraftSelected="OnAircraftSelected"
                          @ref="radarDisplay" />
            @if (isLoadingScenario)
            {
                <div class="loading-overlay">Loading scenario...</div>
            }
        </div>

        <div class="control-section">
            <CommandInput SelectedCallsign="@selectedAircraft?.Callsign"
                          OnCommandSubmitted="OnCommandSubmitted"
                          Parser="@commandParser"
                          @ref="commandInput" />

            <VoiceCommandPanel OnCommandRecognized="HandleVoiceCommand"
                              EnableTextToSpeech="true"
                              Parser="@commandParser" />

            @if (selectedAircraft != null && aircraftHappiness.TryGetValue(selectedAircraft.Callsign, out var happiness))
            {
                <div class="happiness-indicator">
                    <h4>Aircraft Happiness</h4>
                    <div class="happiness-bar">
                        <div class="happiness-fill" style="width: @(happiness.Happiness)%"></div>
                    </div>
                    <span class="happiness-value">@happiness.Happiness.ToString("F0")%</span>

                    <div class="happiness-details">
                        <div class="detail-row">
                            <span>Commands:</span>
                            <span>@happiness.CommandCount</span>
                        </div>
                        <div class="detail-row">
                            <span>Efficiency:</span>
                            <span>@happiness.GetRouteEfficiency().ToString("P0")</span>
                        </div>
                    </div>
                </div>
            }

            @if (currentWeather != null && currentWeather.Available)
            {
                <div class="weather-panel">
                    <h4>Weather · @currentWeather.IcaoId</h4>
                    <div class="detail-row">
                        <span>Wind:</span>
                        <span>
                            @if (currentWeather.WindSpeedKts == 0)
                            {
                                <text>Calm</text>
                            }
                            else if (currentWeather.WindGustKts > 0)
                            {
                                <text>@($"{currentWeather.WindDirDeg:D3}")° @currentWeather.WindSpeedKts G@currentWeather.WindGustKts kts</text>
                            }
                            else
                            {
                                <text>@($"{currentWeather.WindDirDeg:D3}")° @currentWeather.WindSpeedKts kts</text>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span>Visibility:</span>
                        <span>@currentWeather.VisibilitySm SM</span>
                    </div>
                    <div class="detail-row">
                        <span>Altimeter:</span>
                        <span>@currentWeather.AltimeterInhg.ToString("F2") inHg</span>
                    </div>
                    <div class="detail-row">
                        <span>Sky:</span>
                        <span>@(string.IsNullOrEmpty(currentWeather.SkyCover) ? "Clear" : currentWeather.SkyCover)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(currentWeather.FlightCategory))
                    {
                        <div class="detail-row">
                            <span>Category:</span>
                            <span class="flight-cat flight-cat-@currentWeather.FlightCategory.ToLowerInvariant()">@currentWeather.FlightCategory</span>
                        </div>
                    }
                    <div class="detail-row">
                        <span>Temp/Dew:</span>
                        <span>@currentWeather.TempC.ToString("F0")°C / @currentWeather.DewpC.ToString("F0")°C</span>
                    </div>
                </div>
            }

            <div class="aircraft-list">
                <h4>Aircraft (@aircraft.Count)</h4>
                @foreach (var ac in aircraft.OrderBy(a => a.Callsign))
                {
                    <div class="aircraft-item @(selectedAircraft == ac ? "selected" : "")"
                         @onclick="() => SelectAircraft(ac)">
                        <span class="ac-callsign">@ac.Callsign</span>
                        <span class="ac-alt">@((int)(ac.AltitudeFt / 100))↑</span>
                        <span class="ac-spd">@((int)ac.SpeedKnots)</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "openScenarios")]
    public string? OpenScenariosQuery { get; set; }

    private RadarDisplay? radarDisplay;
    private CommandInput? commandInput;

    // Simulation state
    private List<AircraftModel> aircraft = new();
    private List<Fix> fixes = new();
    private AirportModel? airport;
    private List<Runway> runways = new();
    private AircraftModel? selectedAircraft;
    private string scenarioName = "Basic Traffic Pattern";
    private string airportCode = "KSFO";
    private bool isLoadingScenario = false;
    private string? saveStatus;
    private bool pendingInitialAutoSave = false;
    private bool hasCompletedInitialAutoSave = false;
    private bool showScenariosModal = false;
    private bool isLoadingScenarioCatalog = false;
    private string? scenariosModalError;
    private List<ScenarioResponse> availableScenarios = new();
    private ScenarioResponse? selectedScenario;
    private bool handlingOpenScenariosQuery = false;
    
    // Radar center coordinates
    private double CenterLatitude = 33.4255; // Default to Atlanta area
    private double CenterLongitude = -84.4693;

    // Services
    private AtcCommandParser commandParser = new();
    private ClearanceApplicator clearanceApplicator = new();
    private ScoringService scoringService = new();
    private NavigationDatabase navigationDatabase = new();

    // Simulation control
    private bool isPaused = false;  // Start unpaused so aircraft move
    private float timeMultiplier = 1.0f;
    private System.Threading.Timer? simulationTimer;
    private DateTime lastUiRefreshUtc = DateTime.MinValue;
    private readonly TimeSpan uiRefreshInterval = TimeSpan.FromMilliseconds(250);
    private readonly float minRadarZoomLevel = 0.5f;
    private readonly float maxRadarZoomLevel = 20.0f;
    private readonly int radarScreenRefreshRateMs = 2000;

    // Scoring
    private SessionScore sessionScore = new();
    private Dictionary<string, AircraftHappiness> aircraftHappiness = new();

    // Weather
    private WeatherResponse? currentWeather;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += HandleAuthStateChanged;
        await AuthService.InitializeAsync();

        // Load sample navigation data as fallback
        navigationDatabase = SampleNavigationData.CreateSampleDatabase();

        // Start scoring session
        scoringService.StartNewSession($"session-{DateTime.UtcNow:yyyyMMdd-HHmmss}", timeMultiplier);
        sessionScore = scoringService.GetCurrentSession();

        // Load startup scenario via ScenarioService gRPC
        await LoadStartupScenarioAsync();

        // Start simulation loop
        simulationTimer = new System.Threading.Timer(SimulationTick, null, 0, period: radarScreenRefreshRateMs);
    }

    protected override void OnParametersSet()
    {
        if (handlingOpenScenariosQuery)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(OpenScenariosQuery) && OpenScenariosQuery == "1")
        {
            handlingOpenScenariosQuery = true;
            _ = InvokeAsync(async () =>
            {
                await OpenScenariosModalAsync();
                NavigationManager.NavigateTo("/", replace: true);
                handlingOpenScenariosQuery = false;
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!hasCompletedInitialAutoSave &&
            pendingInitialAutoSave &&
            !isLoadingScenario &&
            airport != null &&
            !string.IsNullOrWhiteSpace(airport.IcaoCode) &&
            runways.Count > 0)
        {
            pendingInitialAutoSave = false;
            hasCompletedInitialAutoSave = true;
            await AutoSaveInitialScenarioStateAsync();
        }
    }


    private void SimulationTick(object? state)
    {
        if (isPaused || isLoadingScenario) return;

        float deltaTime = 0.1f * timeMultiplier; // 100ms * multiplier

        // Update all aircraft
        foreach (var ac in aircraft)
        {
            ac.Step(deltaTime);

            // Update distance tracking
            var distFlown = ac.TotalDistanceFlown;
            scoringService.UpdateAircraftDistance(ac.Callsign, distFlown);
        }

        // Check separation violations
        CheckSeparation();

        var now = DateTime.UtcNow;
        if (now - lastUiRefreshUtc < uiRefreshInterval)
        {
            return;
        }

        lastUiRefreshUtc = now;

        // Update UI (throttled to reduce rendering pressure)
        _ = InvokeAsync(async () =>
        {
            if (radarDisplay != null)
            {
                await radarDisplay.UpdateDisplay();
            }

            StateHasChanged();
        });
    }

    private void CheckSeparation()
    {
        for (int i = 0; i < aircraft.Count; i++)
        {
            for (int j = i + 1; j < aircraft.Count; j++)
            {
                var sep = (aircraft[i].PositionNm - aircraft[j].PositionNm).Magnitude;

                if (sep < SimulationConstants.MinimumSeparationNm)
                {
                    scoringService.RecordSeparationViolation(
                        aircraft[i].Callsign,
                        aircraft[j].Callsign,
                        sep
                    );
                }
            }
        }
    }

    private void TogglePause()
    {
        isPaused = !isPaused;
    }

    private async Task OnAircraftSelected(AircraftModel aircraft)
    {
        selectedAircraft = aircraft;
        if (commandInput != null)
        {
            await commandInput.FocusInput();
        }
    }

    private void SelectAircraft(AircraftModel aircraft)
    {
        selectedAircraft = aircraft;
    }

    private async Task OnCommandSubmitted(CommandInput.CommandEntry entry)
    {
        if (entry.ParsedCommand == null || selectedAircraft == null)
            return;

        // Apply command to aircraft
        var (valid, error) = clearanceApplicator.ValidateCommand(entry.ParsedCommand, selectedAircraft);

        if (valid)
        {
            clearanceApplicator.ApplyCommand(entry.ParsedCommand, selectedAircraft);
            scoringService.RecordCommand(selectedAircraft.Callsign, entry.ParsedCommand);

            // Generate pilot readback
            await GeneratePilotReadback(selectedAircraft, entry.ParsedCommand);

            aircraftHappiness = scoringService.GetAllAircraftHappiness();
        }

        await Task.CompletedTask;
    }

    private async Task HandleVoiceCommand(string transcript)
    {
        Console.WriteLine($"[DEBUG] Voice command received: '{transcript}'");
        
        // Parse the voice command
        var parsedCommand = commandParser.Parse(transcript);

        if (parsedCommand == null)
        {
            Console.WriteLine($"[DEBUG] Command could not be parsed: '{transcript}'");
            return;
        }

        Console.WriteLine($"[DEBUG] Parsed command - Type: {parsedCommand.GetType().Name}, Callsign: '{parsedCommand.Callsign}'");

        AircraftModel? targetAircraft = null;

        // If command includes a callsign, find the matching aircraft
        if (!string.IsNullOrEmpty(parsedCommand.Callsign))
        {
            targetAircraft = aircraft.FirstOrDefault(ac => 
                string.Equals(ac.Callsign, parsedCommand.Callsign, StringComparison.OrdinalIgnoreCase));
            
            if (targetAircraft == null)
            {
                Console.WriteLine($"[DEBUG] Aircraft not found for callsign: '{parsedCommand.Callsign}'. Available aircraft: {string.Join(", ", aircraft.Select(a => a.Callsign))}");
                return;
            }
            
            Console.WriteLine($"[DEBUG] Found aircraft: {targetAircraft.Callsign}");
            
            // Auto-select the aircraft for visual feedback
            selectedAircraft = targetAircraft;
        }
        else if (selectedAircraft != null)
        {
            Console.WriteLine($"[DEBUG] Using currently selected aircraft: {selectedAircraft.Callsign}");
            // No callsign in command, use currently selected aircraft
            targetAircraft = selectedAircraft;
        }
        else
        {
            Console.WriteLine($"[DEBUG] No callsign in command and no aircraft selected");
            // No callsign and no selected aircraft
            return;
        }

        // Apply the voice command to the target aircraft
        var (valid, error) = clearanceApplicator.ValidateCommand(parsedCommand, targetAircraft);

        Console.WriteLine($"[DEBUG] Command validation - Valid: {valid}, Error: '{error}'");

        if (valid)
        {
            clearanceApplicator.ApplyCommand(parsedCommand, targetAircraft);
            scoringService.RecordCommand(targetAircraft.Callsign, parsedCommand);

            Console.WriteLine($"[DEBUG] Command applied to {targetAircraft.Callsign}");
            
            // For heading commands, show target heading
            if (parsedCommand is HeadingCommand hc)
            {
                Console.WriteLine($"[DEBUG] Heading command - Target: {hc.TargetHeadingDegrees}°, Current: {targetAircraft.HeadingDegrees}°, Turn Rate: {targetAircraft.TurnRateRadPerSec}");
            }

            // Generate pilot readback
            await GeneratePilotReadback(targetAircraft, parsedCommand);

            aircraftHappiness = scoringService.GetAllAircraftHappiness();
        }
    }

    private async Task GeneratePilotReadback(AircraftModel aircraft, AtcCommand command)
    {
        // Generate appropriate readback based on command type
        string readback = command switch
        {
            HeadingCommand hc => $"Turn {(hc.Direction == TurnDirection.Left ? "left" : "right")} heading {SpellOutNumber((int)hc.TargetHeadingDegrees)}",
            AltitudeCommand ac => $"{(ac.TargetAltitudeFeet > aircraft.AltitudeFt ? "Climb and maintain" : "Descend and maintain")} {SpellOutNumber((int)(ac.TargetAltitudeFeet / 100) * 100)}",
            SpeedCommand sc => $"{(sc.TargetSpeedKnots > aircraft.SpeedKnots ? "Increase" : "Reduce")} speed to {SpellOutNumber((int)sc.TargetSpeedKnots)} knots",
            _ => "Roger"
        };

        var fullText = $"{readback}, {aircraft.Callsign}";

        // Use Piper TTS with the airline-appropriate voice when available
        if (!string.IsNullOrEmpty(aircraft.AssignedPiperVoice))
        {
            var audioData = await SpeechService.SynthesizeSpeechAsync(
                fullText, ATCVoiceProfile.PilotMale, aircraft.AssignedPiperVoice);

            if (audioData.Length > 0)
            {
                var base64Audio = Convert.ToBase64String(audioData);
                await JS.InvokeVoidAsync("playAudioData", base64Audio, "audio/wav");
                return;
            }
        }

        // Fallback to browser Web Speech API
        await TextToSpeech.SpeakPilotReadbackAsync(aircraft.Callsign, readback);
    }

    /// <summary>
    /// Converts a number to individual digits for aviation readback
    /// e.g., 300 -> "three zero zero", 10000 -> "one zero zero zero zero"
    /// </summary>
    private string SpellOutNumber(int number)
    {
        var digitWords = new Dictionary<char, string>
        {
            { '0', "zero" },
            { '1', "one" },
            { '2', "two" },
            { '3', "three" },
            { '4', "four" },
            { '5', "five" },
            { '6', "six" },
            { '7', "seven" },
            { '8', "eight" },
            { '9', "niner" }  // Aviation standard
        };

        var numberStr = number.ToString();
        var words = new List<string>();

        foreach (var digit in numberStr)
        {
            if (digitWords.ContainsKey(digit))
            {
                words.Add(digitWords[digit]);
            }
        }

        return string.Join(" ", words);
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= HandleAuthStateChanged;
        simulationTimer?.Dispose();
        scoringService.EndSession();
    }

    private async Task SaveScenarioAsync()
    {
        if (!AuthService.IsAuthenticated || AuthService.CurrentUser == null)
        {
            saveStatus = "Login required before saving.";
            return;
        }

        try
        {
            var saveRequest = new SaveScenarioStateRequest
            {
                UserId = AuthService.CurrentUser.UserId,
                AirportCode = airportCode,
                SaveName = $"Save {DateTime.Now:HH:mm:ss}",
                ProgressPercentage = sessionScore.Statistics.TotalAircraft > 0
                    ? Math.Min(100, sessionScore.Statistics.SuccessfulLandings * 100.0 / sessionScore.Statistics.TotalAircraft)
                    : 0,
                SavedState = BuildScenarioStateJson()
            };

            var saveResponse = await ScenarioServiceClient.SaveScenarioStateAsync(saveRequest);
            var idPreview = string.IsNullOrWhiteSpace(saveResponse.SavedScenarioId)
                ? "n/a"
                : saveResponse.SavedScenarioId[..Math.Min(8, saveResponse.SavedScenarioId.Length)];
            saveStatus = saveResponse.Success
                ? $"Saved ({idPreview}...) at {DateTime.Now:HH:mm:ss}"
                : $"Save failed: {saveResponse.Message}";
        }
        catch (Exception ex)
        {
            saveStatus = $"Save failed: {ex.Message}";
        }
    }

    private async Task LoadScenarioDisplayDataAsync(float radiusNm = 50.0f, bool includeLiveAircraft = true)
    {
        isLoadingScenario = true;
        saveStatus = null;
        aircraft.Clear();
        runways.Clear();
        fixes.Clear();
        airport = null;
        selectedAircraft = null;

        if (radarDisplay != null)
        {
            await radarDisplay.UpdateDisplay();
        }

        try
        {
            var airportResponse = await ScenarioServiceClient.GetAirportDataAsync(airportCode);

            CenterLatitude = airportResponse.Latitude;
            CenterLongitude = airportResponse.Longitude;

            airport = new AirportModel
            {
                IcaoCode = airportResponse.IcaoCode,
                Name = airportResponse.Name,
                AltitudeFt = airportResponse.ElevationFt,
                PositionNm = new Vector2(0, 0)
            };

            runways = BuildDisplayRunways(airportResponse.Runways);

            if (includeLiveAircraft)
            {
                var initialAircraftResponse = await ScenarioServiceClient.GetInitialAircraftPositionsAsync(airportCode, radiusNm);
                aircraft = initialAircraftResponse.Aircraft
                    .Select(MapAircraft)
                    .ToList();

                foreach (var ac in aircraft)
                {
                    scoringService.RegisterAircraft(ac.Callsign, 30);
                }
            }

            fixes = await LoadWaypointsAsync(airportCode);
            aircraftHappiness = scoringService.GetAllAircraftHappiness();

            // Load weather (failure is silently ignored)
            try
            {
                currentWeather = await ScenarioServiceClient.GetWeatherAsync(airportCode);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[WARN] Weather unavailable: {ex.Message}");
                currentWeather = null;
            }

            scenarioName = includeLiveAircraft
                ? $"Live Scenario - {airportCode}"
                : $"Layout Only - {airportCode}";

            if (!hasCompletedInitialAutoSave &&
                airport != null &&
                !string.IsNullOrWhiteSpace(airport.IcaoCode) &&
                runways.Count > 0)
            {
                pendingInitialAutoSave = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Failed to load scenario display data via gRPC: {ex.Message}");
        }
        finally
        {
            isLoadingScenario = false;
            StateHasChanged();
        }
    }

    private async Task LoadStartupScenarioAsync(float radiusNm = 50.0f)
    {
        try
        {
            var scenarios = await ScenarioServiceClient.ListScenariosAsync(new ListScenariosRequest
            {
                Page = 1,
                PageSize = 1
            });

            if (scenarios.TotalCount <= 0)
            {
                airportCode = "KSFO";
                Console.WriteLine("[INFO] No scenarios found in database. Loading live traffic for default airport KSFO.");
                await LoadScenarioDisplayDataAsync(radiusNm);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[WARN] Unable to check scenario count at startup: {ex.Message}");
        }

        var startupSavedScenarioId = Configuration["ScenarioService:StartupSavedScenarioId"];
        if (!string.IsNullOrWhiteSpace(startupSavedScenarioId))
        {
            var loaded = await TryLoadSavedScenarioAsync(startupSavedScenarioId);
            if (loaded)
            {
                return;
            }

            Console.WriteLine($"[WARN] Failed to load saved scenario '{startupSavedScenarioId}'. Falling back to initial scenario load.");
        }

        await LoadScenarioDisplayDataAsync(radiusNm);
    }

    private async Task OpenScenariosModalAsync()
    {
        showScenariosModal = true;
        scenariosModalError = null;
        await LoadAvailableScenariosAsync();
        StateHasChanged();
    }

    private void CloseScenariosModal()
    {
        showScenariosModal = false;
    }

    private void SelectScenario(ScenarioResponse scenario)
    {
        selectedScenario = scenario;
    }

    private async Task LoadAvailableScenariosAsync()
    {
        isLoadingScenarioCatalog = true;
        scenariosModalError = null;

        try
        {
            var all = new List<ScenarioResponse>();
            var page = 1;
            const int pageSize = 50;

            while (true)
            {
                var response = await ScenarioServiceClient.ListScenariosAsync(new ListScenariosRequest
                {
                    Page = page,
                    PageSize = pageSize
                });

                if (response.Scenarios.Count == 0)
                {
                    break;
                }

                all.AddRange(response.Scenarios);

                if (all.Count >= response.TotalCount)
                {
                    break;
                }

                page++;
            }

            availableScenarios = all
                .OrderBy(s => s.Name)
                .ToList();

            selectedScenario = availableScenarios.FirstOrDefault();
        }
        catch (Exception ex)
        {
            scenariosModalError = $"Failed to load scenarios: {ex.Message}";
            availableScenarios.Clear();
            selectedScenario = null;
        }
        finally
        {
            isLoadingScenarioCatalog = false;
        }
    }

    private async Task LoadSelectedScenarioAsync()
    {
        if (selectedScenario == null)
        {
            return;
        }

        airportCode = string.IsNullOrWhiteSpace(selectedScenario.AirportCode) ? airportCode : selectedScenario.AirportCode;
        await LoadScenarioDisplayDataAsync();
        scenarioName = selectedScenario.Name;
        showScenariosModal = false;
        StateHasChanged();
    }

    private string GetWeatherSummary()
    {
        if (currentWeather == null || !currentWeather.Available) return "Weather unavailable";
        var wind = currentWeather.WindSpeedKts == 0
            ? "Calm"
            : currentWeather.WindGustKts > 0
                ? $"{currentWeather.WindDirDeg:D3}° at {currentWeather.WindSpeedKts}G{currentWeather.WindGustKts} kts"
                : $"{currentWeather.WindDirDeg:D3}° at {currentWeather.WindSpeedKts} kts";
        var cat = string.IsNullOrEmpty(currentWeather.FlightCategory) ? "" : $" · {currentWeather.FlightCategory}";
        return $"{wind} · Vis {currentWeather.VisibilitySm} SM · Alt {currentWeather.AltimeterInhg:F2} inHg{cat}";
    }

    private async Task<bool> TryLoadSavedScenarioAsync(string savedScenarioId)
    {
        isLoadingScenario = true;
        saveStatus = null;
        aircraft.Clear();
        runways.Clear();
        fixes.Clear();
        airport = null;
        selectedAircraft = null;

        if (radarDisplay != null)
        {
            await radarDisplay.UpdateDisplay();
        }

        try
        {
            var session = await ScenarioServiceClient.LoadProgressAsync(savedScenarioId);
            if (session?.AirportData == null || string.IsNullOrWhiteSpace(session.AirportData.IcaoCode))
            {
                Console.WriteLine($"[WARN] Saved scenario '{savedScenarioId}' returned no airport data.");
                return false;
            }

            airportCode = session.AirportData.IcaoCode;
            CenterLatitude = session.AirportData.Latitude;
            CenterLongitude = session.AirportData.Longitude;

            airport = new AirportModel
            {
                IcaoCode = session.AirportData.IcaoCode,
                Name = session.AirportData.Name,
                AltitudeFt = session.AirportData.ElevationFt,
                PositionNm = new Vector2(0, 0)
            };

            runways = BuildDisplayRunways(session.AirportData.Runways);

            aircraft = session.InitialAircraft
                .Select(MapAircraft)
                .ToList();

            foreach (var ac in aircraft)
            {
                scoringService.RegisterAircraft(ac.Callsign, 30);
            }

            fixes = await LoadWaypointsAsync(airportCode);
            aircraftHappiness = scoringService.GetAllAircraftHappiness();
            scenarioName = $"Loaded Scenario - {savedScenarioId[..Math.Min(savedScenarioId.Length, 8)]}...";

            if (!hasCompletedInitialAutoSave &&
                airport != null &&
                !string.IsNullOrWhiteSpace(airport.IcaoCode) &&
                runways.Count > 0)
            {
                pendingInitialAutoSave = true;
            }

            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Failed to load saved scenario '{savedScenarioId}': {ex.Message}");
            return false;
        }
        finally
        {
            isLoadingScenario = false;
            StateHasChanged();
        }
    }

    private async Task AutoSaveInitialScenarioStateAsync()
    {
        try
        {
            var saveRequest = new SaveScenarioStateRequest
            {
                UserId = AuthService.CurrentUser?.UserId ?? "system:auto",
                AirportCode = airportCode,
                SaveName = $"Initial Load {DateTime.Now:HH:mm:ss}",
                ProgressPercentage = 0,
                SavedState = BuildScenarioStateJson()
            };

            var response = await ScenarioServiceClient.SaveScenarioStateAsync(saveRequest);
            if (response.Success)
            {
                Console.WriteLine($"[INFO] Initial scenario state auto-saved at {DateTime.Now:HH:mm:ss}");
            }
            else
            {
                Console.WriteLine($"[WARN] Initial scenario auto-save failed: {response.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[WARN] Initial scenario auto-save failed: {ex.Message}");
        }
    }

    private async Task ReloadLiveTraffic()
    {
        try
        {
            // Clear existing aircraft
            aircraft.Clear();
            var radiusNm = 50.0f;

            // Get live aircraft from ScenarioService gRPC endpoint
            var liveFlights = await ScenarioServiceClient.GetLiveFlightsAsync(airportCode, radiusNm);
            var liveAircraft = liveFlights.Aircraft.Select(MapAircraft);

            // Add live aircraft to simulation
            foreach (var liveAc in liveAircraft)
            {
                aircraft.Add(liveAc);
                scoringService.RegisterAircraft(liveAc.Callsign, 30);
            }

            // Update scenario name to indicate live traffic
            scenarioName = $"Live Traffic - {DateTime.Now:HH:mm:ss}";
            
            // Update happiness tracking
            aircraftHappiness = scoringService.GetAllAircraftHappiness();

            // Update radar display
            if (radarDisplay != null)
            {
                await radarDisplay.UpdateDisplay();
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] Failed to reload live traffic: {ex.Message}");
        }
    }

    private string BuildScenarioStateJson()
    {
        var state = new
        {
            savedAtUtc = DateTime.UtcNow,
            airportCode,
            scenarioName,
            isPaused,
            timeMultiplier,
            score = sessionScore.TotalScore,
            aircraft = aircraft.Select(ac => new
            {
                ac.Callsign,
                ac.AircraftType,
                ac.PositionNm.X,
                ac.PositionNm.Y,
                ac.HeadingDegrees,
                ac.SpeedKnots,
                ac.AltitudeFt,
                ac.VerticalSpeedFpm
            }).ToList()
        };

        return System.Text.Json.JsonSerializer.Serialize(state);
    }

