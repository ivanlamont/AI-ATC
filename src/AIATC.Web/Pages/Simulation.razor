    private List<Runway> BuildDisplayRunways(IEnumerable<RunwayData> runwayDataList)
    {
        var grouped = new Dictionary<string, List<RunwayData>>(StringComparer.OrdinalIgnoreCase);
        var passthrough = new List<RunwayData>();

        foreach (var runwayData in runwayDataList)
        {
            var key = GetPhysicalRunwayKey(runwayData.Identifier);
            if (key == null)
            {
                passthrough.Add(runwayData);
                continue;
            }

            if (!grouped.TryGetValue(key, out var group))
            {
                group = new List<RunwayData>();
                grouped[key] = group;
            }

            group.Add(runwayData);
        }

        var displayRunways = new List<Runway>();

        foreach (var group in grouped.Values)
        {
            var preMerged = group
                .Where(r => (r.Identifier ?? string.Empty).Contains('/'))
                .OrderByDescending(r => r.LengthFt)
                .FirstOrDefault();
            if (preMerged != null)
            {
                displayRunways.Add(MapRunway(preMerged));
                continue;
            }

            if (group.Count < 2)
            {
                displayRunways.Add(MapRunway(group[0]));
                continue;
            }

            RunwayData? bestPrimary = null;
            RunwayData? bestReciprocal = null;
            var bestDistanceNm = 0f;

            foreach (var candidate in group)
            {
                var reciprocal = FindReciprocal(candidate, group);
                if (reciprocal == null)
                {
                    continue;
                }

                var startPos = LatLonToNm(candidate.Latitude, candidate.Longitude, CenterLatitude, CenterLongitude);
                var endPos = LatLonToNm(reciprocal.Latitude, reciprocal.Longitude, CenterLatitude, CenterLongitude);
                var distanceNm = (endPos - startPos).Magnitude;
                if (distanceNm < 0.2f || distanceNm > 10.0f)
                {
                    continue;
                }

                if (distanceNm > bestDistanceNm)
                {
                    bestDistanceNm = distanceNm;
                    bestPrimary = candidate;
                    bestReciprocal = reciprocal;
                }
            }

            if (bestPrimary == null || bestReciprocal == null)
            {
                displayRunways.Add(MapRunway(group.OrderByDescending(r => r.LengthFt).First()));
                continue;
            }

            var start = LatLonToNm(bestPrimary.Latitude, bestPrimary.Longitude, CenterLatitude, CenterLongitude);
            var end = LatLonToNm(bestReciprocal.Latitude, bestReciprocal.Longitude, CenterLatitude, CenterLongitude);
            var delta = end - start;
            var bearingFromGeometry = (float)((Math.Atan2(delta.X, delta.Y) * 180.0 / Math.PI + 360.0) % 360.0);

            var averageLengthFt = (int)Math.Round(group.Average(r => r.LengthFt));
            var averageWidthFt = (int)Math.Round(group.Average(r => r.WidthFt));
            var designator = $"{bestPrimary.Identifier}/{bestReciprocal.Identifier}";

            displayRunways.Add(new Runway
            {
                Identifier = designator,
                AirportIcaoCode = airportCode,
                LengthFt = averageLengthFt,
                WidthFt = averageWidthFt,
                MagneticBearing = bearingFromGeometry,
                ThresholdPositionNm = start,
                EndPositionNm = end,
                ThresholdElevationFt = airport?.AltitudeFt ?? 0
            });
        }

        foreach (var runwayData in passthrough)
        {
            displayRunways.Add(MapRunway(runwayData));
        }

        // Final guard: ensure only one rendered runway per physical runway key.
        return displayRunways
            .GroupBy(r => GetPhysicalRunwayKey(r.Identifier) ?? r.Identifier, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.OrderByDescending(r => r.LengthFt).First())
            .ToList();
    }

    private RunwayData? FindReciprocal(RunwayData source, List<RunwayData> candidates)
    {
        var expected = BuildReciprocalDesignator(source.Identifier);
        if (expected == null)
        {
            return null;
        }

        return candidates
            .Where(r =>
            !ReferenceEquals(r, source) &&
            NormalizeRunwayDesignator(r.Identifier) == expected)
            .OrderBy(r => (LatLonToNm(source.Latitude, source.Longitude, CenterLatitude, CenterLongitude)
                - LatLonToNm(r.Latitude, r.Longitude, CenterLatitude, CenterLongitude)).Magnitude)
            .FirstOrDefault();
    }

    private static string? GetPhysicalRunwayKey(string? identifier)
    {
        if (!string.IsNullOrWhiteSpace(identifier) && identifier.Contains('/'))
        {
            var parts = identifier.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length == 2)
            {
                var a = NormalizeRunwayDesignator(parts[0]);
                var b = NormalizeRunwayDesignator(parts[1]);
                if (a != null && b != null)
                {
                    return string.CompareOrdinal(a, b) <= 0 ? $"{a}|{b}" : $"{b}|{a}";
                }
            }
        }

        var normalized = NormalizeRunwayDesignator(identifier);
        if (normalized == null)
        {
            return null;
        }

        var reciprocal = BuildReciprocalDesignator(normalized);
        if (reciprocal == null)
        {
            return null;
        }

        return string.CompareOrdinal(normalized, reciprocal) <= 0
            ? $"{normalized}|{reciprocal}"
            : $"{reciprocal}|{normalized}";
    }

    private static string? BuildReciprocalDesignator(string? identifier)
    {
        var normalized = NormalizeRunwayDesignator(identifier);
        if (normalized == null)
        {
            return null;
        }

        var match = Regex.Match(normalized, @"^(?<num>\d{2})(?<side>[LRC]?)$");
        if (!match.Success)
        {
            return null;
        }

        var num = int.Parse(match.Groups["num"].Value);
        var side = match.Groups["side"].Value;
        var reciprocalNum = ((num + 18 - 1) % 36) + 1;
        var reciprocalSide = side switch
        {
            "L" => "R",
            "R" => "L",
            _ => side
        };

        return $"{reciprocalNum:00}{reciprocalSide}";
    }

    private static string? NormalizeRunwayDesignator(string? identifier)
    {
        if (string.IsNullOrWhiteSpace(identifier))
        {
            return null;
        }

        var token = identifier.Trim().ToUpperInvariant();
        if (token.StartsWith("RW", StringComparison.Ordinal))
        {
            token = token[2..];
        }

        var match = Regex.Match(token, @"^(?<num>\d{1,2})(?<side>[LRC]?)$");
        if (!match.Success)
        {
            return null;
        }

        var num = int.Parse(match.Groups["num"].Value);
        if (num is < 1 or > 36)
        {
            return null;
        }

        var side = match.Groups["side"].Value;
        return $"{num:00}{side}";
    }

    private Runway MapRunway(RunwayData runwayData)
    {
        var thresholdPositionNm = LatLonToNm(runwayData.Latitude, runwayData.Longitude, CenterLatitude, CenterLongitude);
        var runwayLengthNm = (float)(runwayData.LengthFt / 6076.12);
        var headingRad = (float)(runwayData.Heading * SimulationConstants.DegreesToRadians);

        // runwayData latitude/longitude is treated as threshold; derive opposite end from heading and length.
        var endPositionNm = new Vector2(
            thresholdPositionNm.X + (float)(runwayLengthNm * Math.Sin(headingRad)),
            thresholdPositionNm.Y + (float)(runwayLengthNm * Math.Cos(headingRad)));

        return new Runway
        {
            Identifier = runwayData.Identifier,
            AirportIcaoCode = airportCode,
            LengthFt = (int)Math.Round(runwayData.LengthFt),
            WidthFt = (int)Math.Round(runwayData.WidthFt),
            MagneticBearing = (float)runwayData.Heading,
            ThresholdPositionNm = thresholdPositionNm,
            EndPositionNm = endPositionNm,
            ThresholdElevationFt = airport?.AltitudeFt ?? 0
        };
    }

    private AircraftModel MapAircraft(AircraftPosition aircraftPosition)
    {
        var callsign = aircraftPosition.Callsign;
        var voiceAssignment = AirlineVoiceMapper.AssignVoice(callsign);

        return new AircraftModel
        {
            Callsign = callsign,
            AircraftType = string.IsNullOrWhiteSpace(aircraftPosition.AircraftType) ? "UNK" : aircraftPosition.AircraftType,
            PositionNm = LatLonToNm(aircraftPosition.Latitude, aircraftPosition.Longitude, CenterLatitude, CenterLongitude),
            HeadingDegrees = (float)aircraftPosition.Heading,
            SpeedKnots = aircraftPosition.GroundSpeedKnots > 0 ? (float)aircraftPosition.GroundSpeedKnots : 150f,
            AltitudeFt = aircraftPosition.AltitudeFt,
            VerticalSpeedFpm = (float)aircraftPosition.VerticalSpeedFpm,
            IsArrival = true,
            MinSpeedKnots = 160,
            MaxSpeedKnots = 500,
            Destination = airport,
            AssignedPiperVoice = voiceAssignment.PiperVoiceName
        };
    }

    private static Vector2 LatLonToNm(double latitude, double longitude, double referenceLatitude, double referenceLongitude)
    {
        var latDiff = latitude - referenceLatitude;
        var lonDiff = longitude - referenceLongitude;

        var nmLat = latDiff * 60.0;
        var nmLon = lonDiff * 60.0 * Math.Cos(referenceLatitude * Math.PI / 180.0);

        return new Vector2((float)nmLon, (float)nmLat);
    }

    private async Task<List<Fix>> LoadWaypointsAsync(string code)
    {
        try
        {
            var proceduresResponse = await ScenarioServiceClient.GetProceduresAsync(
                new GetProceduresRequest { AirportCode = code });

            var waypoints = proceduresResponse.Procedures
                .SelectMany(p => p.Waypoints)
                .Where(w => w.Latitude != 0 || w.Longitude != 0)
                .DistinctBy(w => w.Identifier)
                .Select(w => new Fix
                {
                    Identifier = w.Identifier,
                    PositionNm = LatLonToNm(w.Latitude, w.Longitude, CenterLatitude, CenterLongitude),
                    Latitude = w.Latitude,
                    Longitude = w.Longitude,
                    Type = FixType.GPS
                })
                .Take(300)
                .ToList();

            if (waypoints.Count > 0)
            {
                return waypoints;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[WARN] Failed to load waypoints from ARINC DB: {ex.Message}");
        }

        // Fallback to sample data
        return navigationDatabase.GetFixesNear(new Vector2(0, 0), 40).Take(120).ToList();
    }

