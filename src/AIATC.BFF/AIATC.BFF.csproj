<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AIATC.BFF</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ReferenceOutputAssembly="false" tells the compiler not to use AIATC.Web as a
      C# reference (the WASM app's types are not shared with the BFF).
      Private="false" was previously set here but suppressed the Blazor SDK target
      that copies the processed index.html (and other wwwroot files) to the BFF's
      wwwroot during publish — so it has been removed.
    -->
    <ProjectReference Include="..\AIATC.Web\AIATC.Web.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
