<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AIATC.BFF</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Private="false" prevents the WASM project's browser-targeting DLLs from being
      copied into the BFF's publish output (they target the 'browser-wasm' RID and
      would corrupt the server-side dotnet runtime). ReferenceOutputAssembly="false"
      prevents AIATC.Web from being added as a C# compile-time reference.

      SIDE EFFECT: Private="false" also suppresses the Blazor SDK target that copies
      the processed index.html into the BFF wwwroot. We compensate via an explicit
      'find + cp' step in the Dockerfile after 'dotnet publish' runs.

      NOTE: _content/ NuGet package static web assets are never propagated to the BFF
      even without Private="false". Dev-mode serving is handled in Program.cs by
      parsing the WASM project's staticwebassets.development.json manifest.
    -->
    <ProjectReference Include="..\AIATC.Web\AIATC.Web.csproj"
                      Private="false"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
