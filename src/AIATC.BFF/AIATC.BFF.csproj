<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AIATC.BFF</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Private="false" ReferenceOutputAssembly="false" means the BFF does not compile
      the Blazor WASM code; it only causes dotnet publish to emit the WASM static files
      into this project's wwwroot, so UseBlazorFrameworkFiles() can serve them.
    -->
    <ProjectReference Include="..\AIATC.Web\AIATC.Web.csproj"
                      Private="false"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
